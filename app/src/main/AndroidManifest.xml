<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One request to GitHub when the app opens, for the newest release. Nothing else goes out. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- What the Contacts app may ask about the messages (keep in touch), and the private names it keeps: apps signed with the same key only. -->
    <permission
        android:name="${applicationId}.permission.PEOPLE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.yaz.contacts.permission.PRIVATE" />
    <uses-permission android:name="com.yaz.contacts.debug.permission.PRIVATE" />
    <!-- Hands the cards received over the chat to the Contacts app, signed with the same key. -->
    <uses-permission android:name="com.yaz.contacts.permission.CARDS" />
    <uses-permission android:name="com.yaz.contacts.debug.permission.CARDS" />
    <!-- Only used when the user chooses to install updates from the app; Android asks them then. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New messages, and the note after an update. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The messaging app: sends, receives and keeps the messages. Granted with the SMS app role. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- Names and faces on the conversations. Read only, nothing leaves the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Which SIM a message goes out from, when there are two. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Voice messages and calls of the encrypted chat, asked the first time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Encrypted calls: the camera for video calls (asked the first time), declared to
         Android as calls of this app so they ring, take headsets and the lock screen,
         and keep the microphone and camera while the call screen is not in front. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The call's media need it to reach the microphone (Android's WebView asks it). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- An encrypted call follows the phone from Wi-Fi to mobile data without dropping. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- A short buzz when a message arrives, as the phone is set. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The rich chat stays connected while the app is closed, so messages
         arrive at once without a push service, and again after a restart. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Where the phone is, once, when the user taps Place in the composer; never in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The encrypted chat's invite, for the Contacts app when two phones touch: apps signed with the same key only. -->
    <permission
        android:name="${applicationId}.permission.INVITE"
        android:protectionLevel="signature" />

    <!-- Dialer, when installed, shows the calls with a number. -->
    <queries>
        <!-- The Contacts app's private names (signature level). -->
        <provider android:authorities="com.yaz.contacts.private" />
        <provider android:authorities="com.yaz.contacts.debug.private" />
        <!-- The Contacts app's door for cards shared over the chat (signature level). -->
        <provider android:authorities="com.yaz.contacts.cards" />
        <provider android:authorities="com.yaz.contacts.debug.cards" />
        <intent>
            <action android:name="com.dialer.app.action.SHOW_NUMBER" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:memtagMode="sync"
        android:name=".SmsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sms"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Sms">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <!-- A chat invite link (also what the camera reads from a code): asked first, never joined unasked. -->
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="i.delta.chat" />
            </intent-filter>
            <!-- Writing to someone, asked by another app: it only fills the
                 message, the user sends. Android requires these of an SMS app. -->
            <!-- The Contacts app's "verified" mark: a number's conversation, on its keys. Shows only. -->
            <intent-filter>
                <action android:name="com.yaz.sms.action.SHOW_KEYS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="smsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <!-- Text shared from another app, to choose who to send it to. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- A conversation in a floating bubble. -->
        <activity
            android:name=".BubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Sms" />

        <!-- Encrypted calls as Android sees them. Only Telecom may bind it. -->
        <service
            android:name=".core.call.ChatConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <service
            android:name=".core.call.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />

        <!-- A new SMS. Only the system may deliver it. -->
        <receiver
            android:name=".core.sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- A new MMS announced by the network. Only the system may deliver it. -->
        <receiver
            android:name=".core.sms.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- The quick replies of an incoming call, sent by the phone app
             through Telecom. Only the system may ask it. -->
        <service
            android:name=".core.sms.QuickReplyService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Another SMS user's invite to the rich chat, an unseen data SMS on
             this app's port. Only the system may deliver it. -->
        <receiver
            android:name=".core.chat.InviteReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.intent.action.DATA_SMS_RECEIVED" />
                <data android:scheme="sms" android:host="localhost" android:port="18471" />
            </intent-filter>
        </receiver>

        <!-- The rich chat's connection while the app is closed. -->
        <service
            android:name=".core.chat.ChatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the end-to-end encrypted chat with other users connected, to receive messages without a push service." />
        </service>
        <receiver
            android:name=".core.chat.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Sent and delivered reports, and the actions of the notifications. -->
        <receiver
            android:name=".core.sms.SmsStatusReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.sms.NotificationActions"
            android:exported="false" />
        <receiver
            android:name=".core.mms.MmsResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.sms.TimedReceiver"
            android:exported="false" />

        <!-- Picture messages handed to Android's MMS service, and media opened
             in another app: shared one file at a time, never exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mms"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_paths" />
        </provider>

        <!-- After an update the app installed itself: a notification to open it again. -->
        <receiver
            android:name=".core.update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- The Contacts app reads this phone's invite and joins the other's, at the user's tap there. -->
        <provider
            android:name=".core.chat.InviteProvider"
            android:authorities="${applicationId}.invite"
            android:exported="true"
            android:permission="${applicationId}.permission.INVITE" />
        <!-- The Contacts app asks when the last messages with some numbers were, and which unsaved numbers come back often. -->
        <provider
            android:name=".core.sms.MessagesDoor"
            android:authorities="${applicationId}.people"
            android:exported="true"
            android:permission="${applicationId}.permission.PEOPLE" />
        <!-- Pictures from outside decoded in a process of their own,
             with no permission, no files and no network. -->
        <service
            android:name=".core.security.DecoderService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":decoder" />

    </application>
</manifest>
