<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One request to GitHub when the app opens, for the newest release. Nothing else goes out. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used when the user chooses to install updates from the app; Android asks them then. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New messages, and the note after an update. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The messaging app: sends, receives and keeps the messages. Granted with the SMS app role. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- Names and faces on the conversations. Read only, nothing leaves the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Which SIM a message goes out from, when there are two. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- A short buzz when a message arrives, as the phone is set. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The rich chat stays connected while the app is closed, so messages
         arrive at once without a push service, and again after a restart. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Dialer, when installed, shows the calls with a number. -->
    <queries>
        <intent>
            <action android:name="com.dialer.app.action.SHOW_NUMBER" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".SmsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sms"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Sms">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Writing to someone, asked by another app: it only fills the
                 message, the user sends. Android requires these of an SMS app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <!-- Text shared from another app, to choose who to send it to. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- A new SMS. Only the system may deliver it. -->
        <receiver
            android:name=".core.sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- A new MMS announced by the network. Only the system may deliver it. -->
        <receiver
            android:name=".core.sms.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- The quick replies of an incoming call, sent by the phone app
             through Telecom. Only the system may ask it. -->
        <service
            android:name=".core.sms.QuickReplyService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Another SMS user's invite to the rich chat, an unseen data SMS on
             this app's port. Only the system may deliver it. -->
        <receiver
            android:name=".core.chat.InviteReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.intent.action.DATA_SMS_RECEIVED" />
                <data android:scheme="sms" android:host="localhost" android:port="18471" />
            </intent-filter>
        </receiver>

        <!-- The rich chat's connection while the app is closed. -->
        <service
            android:name=".core.chat.ChatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the end-to-end encrypted chat with other users connected, to receive messages without a push service." />
        </service>
        <receiver
            android:name=".core.chat.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Sent and delivered reports, and the actions of the notifications. -->
        <receiver
            android:name=".core.sms.SmsStatusReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.sms.NotificationActions"
            android:exported="false" />
        <receiver
            android:name=".core.mms.MmsResultReceiver"
            android:exported="false" />

        <!-- Picture messages handed to Android's MMS service, and media opened
             in another app: shared one file at a time, never exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mms"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_paths" />
        </provider>

        <!-- After an update the app installed itself: a notification to open it again. -->
        <receiver
            android:name=".core.update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
