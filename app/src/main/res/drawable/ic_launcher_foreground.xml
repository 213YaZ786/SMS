<?xml version="1.0" encoding="utf-8"?>
<!-- SMS's launcher glyph: a bubble in soft relief with three white dots.
     The bubble's grey body is multiplied by a tone of the wallpaper's accent,
     its light lies on it untinted, and the dots lie on top as drawn. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/sms_body"
            android:tint="@color/ic_launcher_bubble"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/sms_shine" />
    <item android:drawable="@drawable/sms_dots" />
</layer-list>
