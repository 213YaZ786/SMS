<resources>
    <!-- The launcher icon follows the wallpaper: the bubble takes a bright tone
         of the accent, 500, which its grey body shades. The ground is the
         bubble's own tone at its rim (the accent times the body's darker grey
         there, system_accent1_700, tone 30), so no pale ring shows around it,
         whatever the mask, as Launcher's, Dialer's and Contacts'. No night ground. -->
    <color name="ic_launcher_background">@android:color/system_accent1_700</color>
    <color name="ic_launcher_bubble">@android:color/system_accent1_500</color>
</resources>
